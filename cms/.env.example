# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# APP_KEYS needs 2+ comma-separated values.
# ─────────────────────────────────────────────────────────────────────────────

# Server — on the Pi this runs under pm2 on 1337 (mccurdy-cms uses 1338)
HOST=0.0.0.0
PORT=1337

# Secrets
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=

# Database — SQLite file lives in .tmp/ (gitignored; back it up on the Pi)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
