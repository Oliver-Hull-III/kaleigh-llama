{
  "homepage": "https://kaleighllama.com",
  "name": "llama",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "bootstrap": "^5.3.8",
    "react": "^19.2.7",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-photo-album": "^3.6.0",
    "react-router-dom": "^7.18.0",
    "react-router-hash-link": "^2.4.3",
    "react-scripts": "^5.0.1",
    "yet-another-react-lightbox": "^3.32.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "prebuild": "node scripts/fetch-content.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build --cname kaleighllama.com",
    "build": "react-scripts build",
    "fetch-content": "node scripts/fetch-content.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js",
      "^react-photo-album/(.*)\\.css$": "<rootDir>/node_modules/react-photo-album/dist/styles/$1.css"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!react-photo-album[/\\\\]).+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
